APP_VERSION=0.0.0-dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ectrm
API_PORT=8000
ECTRM_API_LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUTATION_API_TOKEN=
BOOTSTRAP_ADMIN_TOKEN=
SINGLE_USER_AUTH_ENABLED=false
SINGLE_USER_AUTH_USER_ID=local_admin
SINGLE_USER_AUTH_EMAIL=local-admin@example.com
SINGLE_USER_AUTH_DISPLAY_NAME=Local Admin
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_AUTO_CREATE_USERS=false
GOOGLE_AUTH_DEFAULT_ROLE=TRADER
GOOGLE_AUTH_TIMEOUT_SECONDS=10
SESSION_TTL_HOURS=12
ASSISTANT_ENABLED=true
ASSISTANT_DEFAULT_PROVIDER=openai
ASSISTANT_COMPANY_NAME=ECTRM
ASSISTANT_COMPANY_CONTEXT=ECTRM is a prototype commodity trading and risk platform for operators, traders, risk teams, and administrators.
ASSISTANT_BUSINESS_CONTEXT=The operating model is event-led, with explicit workflows for trade lifecycle events, projections, reference data, and external data ingestion.
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_MAX_OUTPUT_TOKENS=1200
ASSISTANT_MAX_TOOL_ROUNDS=4
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_MODEL=gemini-2.5-flash
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2
EIA_TIMEOUT_SECONDS=30
EIA_SYNC_INTERVAL_MINUTES=360
EIA_SYNC_DEFAULT_LOOKBACK_DAYS=30
EIA_SYNC_SUCCESS_SLA_HOURS=48
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_TIMEOUT_SECONDS=30
FRED_SYNC_INTERVAL_MINUTES=360
FRED_SYNC_DEFAULT_LOOKBACK_DAYS=30
FRED_SYNC_SUCCESS_SLA_HOURS=48
CFTC_BASE_URL=https://publicreporting.cftc.gov
CFTC_TIMEOUT_SECONDS=30
CFTC_SYNC_INTERVAL_MINUTES=1440
CFTC_SYNC_DEFAULT_LOOKBACK_DAYS=60
CFTC_SYNC_SUCCESS_SLA_HOURS=192
CAISO_BASE_URL=https://oasis.caiso.com/oasisapi
CAISO_TIMEOUT_SECONDS=30
CAISO_SYNC_INTERVAL_MINUTES=15
CAISO_SYNC_SUCCESS_SLA_HOURS=2
ERCOT_BASE_URL=https://www.ercot.com/content/cdr/html
ERCOT_TIMEOUT_SECONDS=30
ERCOT_SYNC_INTERVAL_MINUTES=15
ERCOT_SYNC_SUCCESS_SLA_HOURS=2
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_TIMEOUT_SECONDS=30
KALSHI_SYNC_INTERVAL_MINUTES=360
KALSHI_DEFAULT_LOOKBACK_DAYS=90
KALSHI_SYNC_SUCCESS_SLA_HOURS=24
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=ECTRM Weather Ingest (ops@example.com)
