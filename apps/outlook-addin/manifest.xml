<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>ff88c7de-7fd8-4973-aa05-e69101710f3c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ECTRM</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="CommodityAI Integration"/>
  <Description DefaultValue="Save and test CommodityAI API authentication from Outlook."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://docs.commodityai.io/authentication"/>
  <AppDomains>
    <AppDomain>https://commodityai.app</AppDomain>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
        <RequestedHeight>320</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="CommodityAI.Group">
                <Label resid="CommodityAI.GroupLabel"/>
                <Control xsi:type="Button" id="CommodityAI.OpenTaskpaneButton">
                  <Label resid="CommodityAI.ButtonLabel"/>
                  <Supertip>
                    <Title resid="CommodityAI.ButtonLabel"/>
                    <Description resid="CommodityAI.ButtonDescription"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="CommodityAI.Icon16"/>
                    <bt:Image size="32" resid="CommodityAI.Icon32"/>
                    <bt:Image size="80" resid="CommodityAI.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="CommodityAI.Icon16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="CommodityAI.Icon32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="CommodityAI.Icon80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommodityAI.GroupLabel" DefaultValue="CommodityAI"/>
        <bt:String id="CommodityAI.ButtonLabel" DefaultValue="CommodityAI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CommodityAI.ButtonDescription" DefaultValue="Open the CommodityAI authentication taskpane."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
